{
  "name": "cyl-audio-hub",
  "version": "3.0.0",
  "description": "Bateria, equalizador (Equalizer APO), perfis, microfone e binds globais para o Redragon H510-PRO e outros periféricos",
  "author": "Marcelo Vaz Oliveira (CylVersion), baseado no Battery Hub e no Zeus Pro Suite",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-batteries.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "predist": "node scripts/build-batteries.js",
    "dist": "electron-builder",
    "installer": "node scripts/build-installer.js",
    "bench": "node scripts/bench.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-hid": "^3.1.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cyl.audiohub",
    "productName": "CYL Audio Hub",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/node_modules/node-hid/hidapi/**",
      "!**/node_modules/node-hid/src/**",
      "!**/node_modules/node-hid/prebuilds/!(HID-win32-x64)/**",
      "native/AudioEngine.exe"
    ],
    "afterPack": "scripts/after-pack.js",
    "electronLanguages": [
      "en-US",
      "es",
      "es-419",
      "zh-CN",
      "zh-TW",
      "he",
      "pt-BR"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "CYL-Audio-Hub-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CYL Audio Hub"
    }
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "node-hid@3.3.0": true
  },
  "productName": "CYL Audio Hub"
}
